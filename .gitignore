# Node.js / TypeScript
node_modules/
dist/
out/
*.lock

# Python
__pycache__/
*.pyc

# 一次性迁移脚本 / 临时文件 / 备份
fix_*.py
replace_*.py
record_*.py
*_new.rs
*.bak
*.orig
*.rej
symbiosis_*.log

# mdbook 构建产物（mdbook build 自动生成）
book/book/
book/src/SUMMARY.md.bak

# cargo-mutants 输出（cargo mutants 自动生成）
mutants.out/
mutants.out.old/

# proptest 自动生成的回归案例目录
# (运行 cargo test 后会出现在此目录；源码内嵌的 seeds 在 fuzz_tests 模块)
crates/sisyphus-sandbox/proptest-regressions/

# scripts/run_test_chunks.sh 的断点续跑状态与逐 crate 日志。
# 临时产物，不入库：进度文件与目标机器的已完成集绑定，
# 提交上去只会让别人的 checkout 误以为“已经测过了”。
.testall-progress
.testall-state
.testall-state.log.*
.testall-timings
.testall-chunk.log
.testall-chunk.log.*
.testall-chunk-summary.log
.testall.log
# 重型 crate 逐个验收时写的计时戳与日志（.heavy-*.log 已被上面的 *.log 覆盖）
.heavy.start
.heavy2.start
.heavy.end
.heavy2.end
.bridge-state
.bridge-state.log.*

# opencode / sisyphus 代理运行时会话产物：指标采样与会话状态，
# 属于本机状态而非仓库内容。
.opencode/
