#!/usr/bin/env bash
set -euo pipefail

echo "Running pre-commit checks..."

# Format check
echo "→ cargo fmt --all --check"
if ! cargo fmt --all --check; then
    echo "❌ Formatting check failed. Run 'cargo fmt --all' to fix."
    exit 1
fi

# Clippy (workspace, excluding bridge/sandbox which require nightly)
echo "→ cargo clippy"
if ! cargo clippy --workspace --exclude sisyphus-bridge --exclude sisyphus-sandbox -- -D warnings 2>&1; then
    echo "❌ Clippy check failed."
    exit 1
fi

# Quick compile check
echo "→ cargo check-all"
if ! cargo check-all 2>&1; then
    echo "❌ Compilation check failed."
    exit 1
fi

echo "✅ Pre-commit checks passed."
