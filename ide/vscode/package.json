{
  "name": "sisyphus",
  "displayName": "Sisyphus 认知引擎",
  "description": "用于 VS Code 的 AI 认知执行引擎集成",
  "version": "0.2.0",
  "publisher": "sisyphus",
  "license": "MIT",
  "engines": { "vscode": "^1.90.0" },
  "categories": ["AI", "Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      { "command": "sisyphus.status", "title": "Sisyphus: 显示状态" },
      { "command": "sisyphus.newSession", "title": "Sisyphus: 新建会话" },
      { "command": "sisyphus.searchMemory", "title": "Sisyphus: 搜索记忆" },
      { "command": "sisyphus.executeSop", "title": "Sisyphus: 执行 SOP" },
      { "command": "sisyphus.showDag", "title": "Sisyphus: 显示 DAG" },
      { "command": "sisyphus.refreshSessions", "title": "Sisyphus: 刷新会话列表" },
      { "command": "sisyphus.deleteSession", "title": "Sisyphus: 删除会话" }
    ],
    "viewsContainers": {
      "activitybar": [
        { "id": "sisyphus", "title": "Sisyphus", "icon": "resources/icon.svg" }
      ]
    },
    "views": {
      "sisyphus": [
        { "type": "webview", "id": "sisyphus.dagView", "name": "DAG 查看器" },
        { "type": "webview", "id": "sisyphus.agentView", "name": "Agent" },
        { "type": "treeView", "id": "sisyphus.sessionView", "name": "会话", "when": "config.sisyphus.baseUrl" }
      ]
    },
    "configuration": {
      "title": "Sisyphus",
      "properties": {
        "sisyphus.baseUrl": { "type": "string", "default": "http://localhost:8080", "description": "Sisyphus REST API 基础 URL" },
        "sisyphus.authToken": { "type": "string", "default": "", "description": "用于认证的 Bearer token" },
        "sisyphus.refreshInterval": { "type": "number", "default": 15, "minimum": 5, "description": "状态刷新间隔（秒）" },
        "sisyphus.autoRefreshSessions": { "type": "boolean", "default": true, "description": "自动刷新会话列表" }
      }
    }
  },
  "scripts": {
    "build": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.5.0"
  }
}
