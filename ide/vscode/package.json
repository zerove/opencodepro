{
  "name": "sisyphus",
  "displayName": "Sisyphus Cognitive Engine",
  "description": "AI-powered cognitive execution engine integration for VS Code",
  "version": "0.2.0",
  "publisher": "sisyphus",
  "license": "MIT",
  "engines": { "vscode": "^1.90.0" },
  "categories": ["AI", "Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      { "command": "sisyphus.status", "title": "Sisyphus: Show Status" },
      { "command": "sisyphus.newSession", "title": "Sisyphus: New Session" },
      { "command": "sisyphus.searchMemory", "title": "Sisyphus: Search Memory" },
      { "command": "sisyphus.executeSop", "title": "Sisyphus: Execute SOP" },
      { "command": "sisyphus.showDag", "title": "Sisyphus: Show DAG" }
    ],
    "viewsContainers": {
      "activitybar": [
        { "id": "sisyphus", "title": "Sisyphus", "icon": "resources/icon.svg" }
      ]
    },
    "views": {
      "sisyphus": [
        { "type": "webview", "id": "sisyphus.dagView", "name": "DAG Viewer" },
        { "type": "webview", "id": "sisyphus.agentView", "name": "Agent" }
      ]
    },
    "configuration": {
      "title": "Sisyphus",
      "properties": {
        "sisyphus.baseUrl": { "type": "string", "default": "http://localhost:8080", "description": "Sisyphus REST API base URL" },
        "sisyphus.authToken": { "type": "string", "default": "", "description": "Bearer token for authentication" }
      }
    }
  },
  "scripts": {
    "build": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.5.0"
  }
}
