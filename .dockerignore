# ── Sisyphus .dockerignore ────────────────────────────────────────────
# Exclude local build artifacts and non-essential files from Docker context.

# Rust build artifacts
target/
**/target/

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~

# Node.js (for webui)
node_modules/
**/node_modules/

# Python (for SDK)
**/__pycache__/
*.pyc
*.pyo
.venv/
venv/

# OS metadata
.DS_Store
Thumbs.db

# Git
.git/

# Docker files (not needed inside the build context for Rust compilation)
docker-compose.yml
.dockerignore

# Documentation (not needed for build)
book/
docs/

# Evaluation data
evals/

# Environment and local config
.env
.env.local
*.toml.bak
