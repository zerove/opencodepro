# ── Sisyphus .dockerignore ────────────────────────────────────────────
# Exclude local build artifacts and non-essential files from Docker context.

# Rust build artifacts
target/
**/target/

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~

# Node.js (for webui)
node_modules/
**/node_modules/

# Python (for SDK)
**/__pycache__/
*.pyc
*.pyo
.venv/
venv/

# OS metadata
.DS_Store
Thumbs.db

# Git
.git/

# Docker files (not needed inside the build context for Rust compilation)
docker-compose.yml
.dockerignore

# Documentation (not needed for build)
book/
docs/

# 注意：不要忽略 evals/。它是 workspace 成员（根 Cargo.toml 的 members 里有
# "evals"），任何 member 的 manifest 缺失时 cargo 会直接拒绝加载整个 workspace：
#   error: failed to load manifest for workspace member `/app/evals`
# 于是 `cargo build -p sisyphus-bridge` 在 Docker 里必然失败——即使桥接本身
# 根本不依赖 evals。整个目录只有 ~300KB，留在上下文里成本可忽略。

# Environment and local config
.env
.env.local
*.toml.bak
