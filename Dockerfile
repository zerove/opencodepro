# ── Sisyphus Bridge Dockerfile ─────────────────────────────────────────
# Multi-stage build: compile with the toolchain pinned by rust-toolchain.toml,
# run on minimal debian.
# gRPC (50051) + HTTP (8080).
#
# 基础镜像为什么是 `rust:1.99.1-slim-bookworm`（stable）而不是 `rust:nightly-*`：
# Docker 官方 rust 镜像**已不再发布任何 nightly 标签**（nightly 迁到
# `rustlang/rust`，且只保留最近几天）。原来写死的 `rust:nightly-slim-bookworm`
# 因此以 "failed to resolve source metadata ... not found" 直接失败 ——
# 多架构镜像发布从未真正成功过。
# 这里用官方 stable 镜像作为**宿主**（它有 rustup），再用 rustup 安装
# rust-toolchain.toml 里 pin 的 nightly，所以版本仍是单点维护。

# Stage 1: Builder
FROM rust:1.99.1-slim-bookworm AS builder

# Install build dependencies (pkg-config for openssl-sys, libssl-dev for tonic)
#
# protobuf-compiler 是**必需**的：`sisyphus-bridge-api` 的 build script 用
# tonic-build 从 bridge.proto 生成代码，缺 protoc 时镜像里报
#
#   error: failed to run custom build command for `sisyphus-bridge-api`
#   Error: Custom { kind: NotFound, error: "Could not find `protoc`" }
#
# 而 `cargo build --release -p sisyphus-bridge` 在本地主机上不会暴露它——
# 本机早就装了 protoc（也因为 CI 各 job 是显式 setup-protoc 装的）。
# scripts/audit_dockerfile.py 会校验：只要有成员在 build-dependencies 里用
# tonic-build，这里就必须装 protobuf-compiler。
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 工具链版本只在 rust-toolchain.toml 里维护（与 CI 的
# ./.github/actions/setup-rust 同一个来源）。文件里的 channel 缺失时
# rustup install 会直接失败，不会静默退化成宿主镜像自带的 stable。
COPY rust-toolchain.toml ./
RUN rustup toolchain install \
        "$(sed -n 's/^channel[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' rust-toolchain.toml)" \
        --profile minimal \
    && cargo --version

# >>> deps-layer (generated by scripts/audit_dockerfile.py --fix) >>>

# workspace 的**每个**成员 manifest 都必须在这里：cargo 加载 workspace
# 时任何成员缺失都会整体失败（`error: failed to load manifest for
# workspace member`），`-p sisyphus-bridge` 也不例外。
COPY Cargo.toml Cargo.lock ./
COPY crates/sisyphus-bridge/Cargo.toml crates/sisyphus-bridge/
COPY crates/sisyphus-bridge-api/Cargo.toml crates/sisyphus-bridge-api/
COPY crates/sisyphus-cli/Cargo.toml crates/sisyphus-cli/
COPY crates/sisyphus-core/Cargo.toml crates/sisyphus-core/
COPY crates/sisyphus-intel/Cargo.toml crates/sisyphus-intel/
COPY crates/sisyphus-knowledge/Cargo.toml crates/sisyphus-knowledge/
COPY crates/sisyphus-mem/Cargo.toml crates/sisyphus-mem/
COPY crates/sisyphus-metrics/Cargo.toml crates/sisyphus-metrics/
COPY crates/sisyphus-roadmap/Cargo.toml crates/sisyphus-roadmap/
COPY crates/sisyphus-sandbox/Cargo.toml crates/sisyphus-sandbox/
COPY crates/sisyphus-sandboxd/Cargo.toml crates/sisyphus-sandboxd/
COPY crates/sisyphus-tests/Cargo.toml crates/sisyphus-tests/
COPY crates/sisyphus-tools-agent/Cargo.toml crates/sisyphus-tools-agent/
COPY crates/sisyphus-tools-build/Cargo.toml crates/sisyphus-tools-build/
COPY crates/sisyphus-tools-core/Cargo.toml crates/sisyphus-tools-core/
COPY crates/sisyphus-tools-executor/Cargo.toml crates/sisyphus-tools-executor/
COPY crates/sisyphus-tools-llm/Cargo.toml crates/sisyphus-tools-llm/
COPY crates/sisyphus-tools-llm-tools/Cargo.toml crates/sisyphus-tools-llm-tools/
COPY crates/sisyphus-tools-mcp/Cargo.toml crates/sisyphus-tools-mcp/
COPY crates/sisyphus-tools-scm/Cargo.toml crates/sisyphus-tools-scm/
COPY crates/sisyphus-tools-session/Cargo.toml crates/sisyphus-tools-session/
COPY crates/sisyphus-tools-system/Cargo.toml crates/sisyphus-tools-system/
COPY crates/sisyphus-types/Cargo.toml crates/sisyphus-types/
COPY crates/sisyphus-visual/Cargo.toml crates/sisyphus-visual/
COPY crates/sisyphus-wasm-sdk/Cargo.toml crates/sisyphus-wasm-sdk/
COPY evals/Cargo.toml evals/
COPY webui/Cargo.toml webui/

# 显式声明了 path 的 target 文件同样必须在场，否则 cargo 连 metadata
# 都不给（`can't find ... bin at ...`）。这里只造空壳，用来把**外部
# 依赖**编进本层缓存；下一层 `COPY . .` 会用真实代码覆盖。
RUN mkdir -p crates/sisyphus-bridge-api/src && echo "" > crates/sisyphus-bridge-api/src/lib.rs && \
    mkdir -p crates/sisyphus-bridge/src && echo "" > crates/sisyphus-bridge/src/lib.rs && \
    mkdir -p crates/sisyphus-cli/src && echo "" > crates/sisyphus-cli/src/lib.rs && \
    mkdir -p crates/sisyphus-cli/src && echo "fn main() {}" > crates/sisyphus-cli/src/main.rs && \
    mkdir -p crates/sisyphus-core/benches && echo "fn main() {}" > crates/sisyphus-core/benches/core_benches.rs && \
    mkdir -p crates/sisyphus-core/benches && echo "fn main() {}" > crates/sisyphus-core/benches/lightweight_benches.rs && \
    mkdir -p crates/sisyphus-core/src/bin && echo "fn main() {}" > crates/sisyphus-core/src/bin/integration_stress.rs && \
    mkdir -p crates/sisyphus-core/src && echo "" > crates/sisyphus-core/src/lib.rs && \
    mkdir -p crates/sisyphus-intel/benches && echo "fn main() {}" > crates/sisyphus-intel/benches/cognitive_benches.rs && \
    mkdir -p crates/sisyphus-intel/src && echo "" > crates/sisyphus-intel/src/lib.rs && \
    mkdir -p crates/sisyphus-knowledge/src && echo "" > crates/sisyphus-knowledge/src/lib.rs && \
    mkdir -p crates/sisyphus-mem/src && echo "" > crates/sisyphus-mem/src/lib.rs && \
    mkdir -p crates/sisyphus-metrics/src && echo "" > crates/sisyphus-metrics/src/lib.rs && \
    mkdir -p crates/sisyphus-roadmap/src && echo "" > crates/sisyphus-roadmap/src/lib.rs && \
    mkdir -p crates/sisyphus-sandbox/src && echo "" > crates/sisyphus-sandbox/src/lib.rs && \
    mkdir -p crates/sisyphus-sandboxd/src && echo "" > crates/sisyphus-sandboxd/src/lib.rs && \
    mkdir -p crates/sisyphus-tests/src && echo "" > crates/sisyphus-tests/src/lib.rs && \
    mkdir -p crates/sisyphus-tools-agent/src && echo "" > crates/sisyphus-tools-agent/src/lib.rs && \
    mkdir -p crates/sisyphus-tools-build/src && echo "" > crates/sisyphus-tools-build/src/lib.rs && \
    mkdir -p crates/sisyphus-tools-core/src && echo "" > crates/sisyphus-tools-core/src/lib.rs && \
    mkdir -p crates/sisyphus-tools-executor/src && echo "" > crates/sisyphus-tools-executor/src/lib.rs && \
    mkdir -p crates/sisyphus-tools-llm-tools/src && echo "" > crates/sisyphus-tools-llm-tools/src/lib.rs && \
    mkdir -p crates/sisyphus-tools-llm/src && echo "" > crates/sisyphus-tools-llm/src/lib.rs && \
    mkdir -p crates/sisyphus-tools-mcp/src && echo "" > crates/sisyphus-tools-mcp/src/lib.rs && \
    mkdir -p crates/sisyphus-tools-scm/src && echo "" > crates/sisyphus-tools-scm/src/lib.rs && \
    mkdir -p crates/sisyphus-tools-session/src && echo "" > crates/sisyphus-tools-session/src/lib.rs && \
    mkdir -p crates/sisyphus-tools-system/src && echo "" > crates/sisyphus-tools-system/src/lib.rs && \
    mkdir -p crates/sisyphus-types/src && echo "" > crates/sisyphus-types/src/lib.rs && \
    mkdir -p crates/sisyphus-visual/src && echo "" > crates/sisyphus-visual/src/lib.rs && \
    mkdir -p crates/sisyphus-wasm-sdk/src && echo "" > crates/sisyphus-wasm-sdk/src/lib.rs && \
    mkdir -p evals/golden_sop && echo "fn main() {}" > evals/golden_sop/eval.rs && \
    mkdir -p evals/golden_sop && echo "fn main() {}" > evals/golden_sop/exec_eval.rs && \
    mkdir -p evals/golden_sop && echo "fn main() {}" > evals/golden_sop/recall_benchmark.rs && \
    mkdir -p evals/golden_sop && echo "fn main() {}" > evals/golden_sop/trend.rs && \
    mkdir -p evals && echo "fn main() {}" > evals/http_client_bench.rs && \
    mkdir -p evals && echo "fn main() {}" > evals/metrics_coverage.rs && \
    mkdir -p evals && echo "fn main() {}" > evals/no_panic_check.rs && \
    mkdir -p evals && echo "fn main() {}" > evals/runner.rs && \
    mkdir -p evals && echo "fn main() {}" > evals/self_prog_demo.rs && \
    mkdir -p evals/src && echo "" > evals/src/lib.rs && \
    mkdir -p webui/src && echo "" > webui/src/lib.rs

# 只编译依赖。空壳源码下这条命令**必须**成功：任何失败都说明本层
# 配置写错了。这里一度写着 `2>/dev/null || true`——它把「workspace 加载
# 失败」吞成成功，于是本层从未缓存过依赖，还顺带掩盖了 evals 被
# .dockerignore 排掉的缺陷。不要加回任何形式的容错。
RUN cargo build --release -p sisyphus-bridge

# <<< deps-layer <<<

# Now copy the full source and rebuild (only changed crates recompile)
COPY . .

# 必须把源码的 mtime 推到「现在」，否则**空壳会被当成最新**：
#
# `COPY` 保留构建上下文里的 mtime（git checkout 的时刻），而上一层的空壳
# `src/lib.rs` 是**更晚**创建/缓存出来的。cargo 按 mtime 判断是否需要重编，
# 于是真实源码看起来比缓存指纹更旧 → 一个 workspace crate 都不重编，直接
# 链接空壳的 rlib，最后 73 个错误：
#
#   error[E0432]: unresolved import `sisyphus_types::ToolError`
#   error[E0405]: cannot find trait `ToolExecutor` in crate `sisyphus_types`
#
# 证据：失败日志里 `Compiling sisyphus-types` 出现 0 次。touch 之后外部依赖
# （~/.cargo/registry）的指纹不受影响，仍然命中缓存，只有 workspace 源码重编。
RUN find . -path ./target -prune -o \
        \( -name '*.rs' -o -name 'Cargo.toml' -o -name 'Cargo.lock' -o -name '*.proto' \) \
        -print0 | xargs -0 touch

# Build the bridge service in release mode
RUN cargo build --release -p sisyphus-bridge

# Stage 2: Runtime
FROM debian:bookworm-slim

# Install runtime dependencies (ca-certificates for HTTPS, libssl3 for tonic)
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Create data directory for persistent state
RUN mkdir -p /app/data

# Copy the compiled binary from the builder stage
COPY --from=builder /app/target/release/sisyphus-bridge /app/sisyphus-bridge

# Copy default config
COPY --from=builder /app/config.example.toml /app/config.toml

# Set environment variables
ENV SISYPHUS_CONFIG=/app/config.toml
ENV SISYPHUS_DATA_DIR=/app/data

# Expose gRPC and HTTP ports
EXPOSE 50051 8080

# Health check (gRPC health probe — requires grpc_health_probe binary in production)
# HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
#   CMD grpc_health_probe -addr=localhost:50051 || exit 1

ENTRYPOINT ["/app/sisyphus-bridge"]
